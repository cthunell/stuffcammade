# Copy to .env for local development. Real values live only in Vercel and your .env (never committed).
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
# The only Google account allowed into private pages
ALLOWED_EMAIL=
# Upstash Redis (set automatically by the Vercel Upstash integration)
KV_REST_API_URL=
KV_REST_API_TOKEN=

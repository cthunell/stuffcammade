---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, summary, status, tags, started, link } = project.data;
const { Content } = await render(project);
---

<Base title={title} description={summary}>
  <p><a href="/">← All projects</a></p>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <p class="meta muted">
        <span class="tag">{status}</span>
        <span>Started {started.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })}</span>
        {tags.length > 0 && <span>{tags.join(' · ')}</span>}
      </p>
      {link && <p><a href={link}>Visit project →</a></p>}
    </header>
    <div class="content">
      <Content />
    </div>
  </article>
</Base>

<style>
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.5rem);
    margin: 1.5rem 0 0.5rem;
  }
  .lead {
    font-size: 1.15rem;
    color: var(--muted);
    margin: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }
  .content {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>

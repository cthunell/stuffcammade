---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Featured first, then newest.
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.started.valueOf() - a.data.started.valueOf(),
);
const sections = [
  { title: 'Live', projects: projects.filter((p) => p.data.status === 'live') },
  {
    title: 'In development',
    projects: projects.filter((p) => ['idea', 'prototype', 'in progress'].includes(p.data.status)),
  },
].filter((section) => section.projects.length > 0);
---

<Base>
  <section class="hero">
    <h1>Hi, I'm Cam.</h1>
    <p class="lead">
      This is where I keep the things I build: side projects, experiments, and tools for personal
      growth and getting organized. Some are finished, most are works in progress.
    </p>
  </section>

  {
    sections.map((section, i) => (
      <section>
        <div class="section-head">
          <h2>{section.title}</h2>
          {i === 0 && <a href="/projects/">All projects →</a>}
        </div>
        <div class="grid">
          {section.projects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    ))
  }
</Base>

<style>
  .hero h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    margin: 0 0 0.75rem;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--muted);
    margin: 0 0 3rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .grid {
    display: grid;
    gap: 1rem;
  }
  section + section {
    margin-top: 2.5rem;
  }
</style>

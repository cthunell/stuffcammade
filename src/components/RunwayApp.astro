---
// Runway: a monthly budget and cash forecast. "private" saves to the signed-in account;
// "demo" starts blank and keeps everything in the visitor's browser.
interface Props {
  mode: 'private' | 'demo';
}

const { mode } = Astro.props;
const nav = [
  ['dashboard', 'Dashboard'],
  ['checkin', 'Check-in'],
];
// The inputs behind the forecast, grouped so the sidebar stays short.
const plan = [
  ['bills', 'Bills'],
  ['income', 'Income'],
  ['budget', 'Budget'],
  ['goals', 'Savings & goals'],
];
const after = [
  ['investments', 'Investments'],
  ['settings', 'Settings'],
];
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">

<div class="app" id="runway" data-mode={mode}>
  <nav class="side" aria-label="Runway sections">
    <a class="brand" href="#dashboard">Runway<small>Budget &amp; cash forecast</small></a>
    {nav.map(([id, label]) => (
      <a data-nav={id} href={`#${id}`}>{label}{id === 'checkin' && <span class="due" hidden>due</span>}</a>
    ))}
    <details class="grp" id="planGroup" open>
      <summary>Plan</summary>
      <div class="grp-items">{plan.map(([id, label]) => <a data-nav={id} href={`#${id}`}>{label}</a>)}</div>
    </details>
    {after.map(([id, label]) => <a data-nav={id} href={`#${id}`}>{label}</a>)}
    <div class="foot">
      <span id="saveStatus" aria-live="polite"></span>
      {mode === 'private'
        ? <a href="/api/auth/signout">Sign out</a>
        : <span>Demo: your numbers stay in this browser and are never sent anywhere.</span>}
      <a href="/">← stuffcammade.com</a>
    </div>
  </nav>
  <main id="view"><p class="muted">Loading…</p></main>
</div>

<script>
  import '../scripts/runway/app.js';
</script>

<style is:global>
:root{
  --bg:#eef1f3; --panel:#ffffff; --ink:#15212b; --muted:#5d6b77; --line:#d9e0e5;
  --accent:#1f6f8b; --accent-soft:#dcecf2;
  --good:#1d7a52; --good-soft:#dff2e8; --warn:#9a6a00; --warn-soft:#fbf0d4; --bad:#b83a2e; --bad-soft:#f9e3df;
  --nav:#15212b; --nav-ink:#c9d4dc; --nav-active:#ffffff;
  --p1:#1f6f8b; --p2:#e08a3c; --p3:#2f9e6e; --p4:#8a5cc2; --p5:#d1576b; --p6:#c9a227; --p7:#4a90c9; --p8:#b8c2ca;
  --f-display:"Sora", "Segoe UI", system-ui, sans-serif;
  --f-body:"IBM Plex Sans", "Segoe UI", system-ui, sans-serif;
  --f-data:"IBM Plex Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#0f161c; --panel:#17212a; --ink:#e4ebf0; --muted:#93a3af; --line:#26333e;
  --accent:#5fb3d1; --accent-soft:#16303c;
  --good:#5cc993; --good-soft:#143326; --warn:#e6b84c; --warn-soft:#352b12; --bad:#f07f70; --bad-soft:#3b1d19;
  --nav:#0a1015; --nav-ink:#8fa0ad; --nav-active:#ffffff; color-scheme:dark;
  --p1:#5fb3d1; --p2:#f0a35e; --p3:#5cc993; --p4:#b18be0; --p5:#ef7d8f; --p6:#e2c254; --p7:#7fb6e8; --p8:#3a4853 }}
:root[data-theme="dark"]{
  --bg:#0f161c; --panel:#17212a; --ink:#e4ebf0; --muted:#93a3af; --line:#26333e;
  --accent:#5fb3d1; --accent-soft:#16303c;
  --good:#5cc993; --good-soft:#143326; --warn:#e6b84c; --warn-soft:#352b12; --bad:#f07f70; --bad-soft:#3b1d19;
  --nav:#0a1015; --nav-ink:#8fa0ad; --nav-active:#ffffff; color-scheme:dark;
  --p1:#5fb3d1; --p2:#f0a35e; --p3:#5cc993; --p4:#b18be0; --p5:#ef7d8f; --p6:#e2c254; --p7:#7fb6e8; --p8:#3a4853 }
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:15px/1.5 var(--f-body)}
a{color:var(--accent)}
[hidden]{display:none!important}
.app{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:100vh}
nav.side{background:var(--nav);color:var(--nav-ink);padding:22px 14px;display:flex;flex-direction:column;gap:4px;position:sticky;top:0;height:100vh}
.side .brand{font:700 19px var(--f-display);color:var(--nav-active);padding:0 10px 18px;letter-spacing:-.01em;text-decoration:none;display:block}
.side .brand small{display:block;font:500 11px var(--f-body);color:var(--nav-ink);letter-spacing:.08em;text-transform:uppercase;margin-top:2px}
.side a[data-nav]{color:var(--nav-ink);text-decoration:none;padding:9px 10px;border-radius:8px;font-weight:500;display:flex;justify-content:space-between;align-items:center}
.side a[data-nav]:hover{background:rgba(255,255,255,.06)}
.side .grp summary{font:inherit;font-weight:500;color:var(--nav-ink);padding:9px 10px;border-radius:8px;font-weight:500;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center}
.side .grp summary::-webkit-details-marker{display:none}
.side .grp summary::after{content:'';width:6px;height:6px;border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;transform:rotate(-45deg);margin-right:4px;transition:transform .15s}
.side .grp[open] summary::after{transform:rotate(45deg)}
.side .grp summary:hover{background:rgba(255,255,255,.06)}
.side .grp:not([open]):has(a.on) summary{color:var(--nav-active)}
.side .grp a[data-nav]{padding-left:22px}
.side a.on{background:rgba(255,255,255,.1);color:var(--nav-active)}
.side .due{font:500 11px var(--f-data);background:var(--warn);color:#1b1400;border-radius:99px;padding:1px 7px}
.side .foot{margin-top:auto;font-size:12px;padding:10px;line-height:1.45;display:flex;flex-direction:column;gap:8px}
.side .foot a{color:var(--nav-ink)}
#saveStatus:empty{display:none}
main{padding-block:24px 48px;padding-left:max(28px, env(safe-area-inset-left,0px));padding-right:max(28px, env(safe-area-inset-right,0px));display:flex;flex-direction:column;gap:18px;min-width:0;max-width:1240px}
.top{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
.top h1{font:600 22px var(--f-display);margin:0;letter-spacing:-.01em}
.mode{display:inline-flex;background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:3px}
.mode button{font:600 13px var(--f-body);border:0;background:transparent;color:var(--muted);padding:7px 14px;border-radius:7px;cursor:pointer}
.mode button[aria-pressed="true"]{background:var(--accent);color:#fff}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px 20px;min-width:0}
.panel h2,.chart-head h2{font:600 15px var(--f-display);margin:0 0 4px}
.panel > p{margin:6px 0 0}
.muted{color:var(--muted)}
.small{font-size:13px}
.good{color:var(--good)} .bad{color:var(--bad)}
.hero{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:20px;align-items:center}
.eyebrow{font:500 11px var(--f-body);text-transform:uppercase;letter-spacing:.09em;color:var(--muted)}
.big{font:700 clamp(30px,4vw,44px)/1.1 var(--f-display);letter-spacing:-.02em;margin:6px 0;text-wrap:balance}
.hero p{margin:0;color:var(--muted);max-width:56ch}
.hero-side{border-left:1px solid var(--line);padding-left:20px;display:flex;flex-direction:column;gap:14px;align-self:stretch;justify-content:center}
.hero-side .side-sec{display:flex;flex-direction:column;gap:3px}
.hero-side .side-v{font:600 22px var(--f-data);letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.hero-side .side-u{font:500 13px var(--f-body);color:var(--muted);letter-spacing:0}
.hero-side .s{font-size:12px;color:var(--muted)}
.spark{width:100%;height:48px;display:block}
.spark line{stroke:var(--line);stroke-dasharray:3 3}
.spark polyline{fill:none;stroke-width:2;vector-effect:non-scaling-stroke;stroke-linejoin:round}
.spark.up polyline{stroke:var(--good)} .spark.down polyline{stroke:var(--bad)}
.side-ci{display:flex;justify-content:space-between;gap:8px;font-size:13px;font-weight:600;text-decoration:none;color:inherit;border-top:1px solid var(--line);padding-top:10px}
.side-ci span{font-weight:400;color:var(--muted)}
.side-ci.due{color:var(--bad)}
.checkin{border-left:1px solid var(--line);padding-left:20px;display:flex;flex-direction:column;gap:8px}
.checkin label{font-weight:600;font-size:13px}
.checkin .row{display:flex;gap:8px}
.checkin input{flex:1;min-width:0;font:500 16px var(--f-data)}
.checkin .note{font-size:12px;color:var(--muted)}
.delta{display:inline-block;font:500 12px var(--f-data);padding:1px 7px;border-radius:99px;background:var(--good-soft);color:var(--good)}
.delta.bad{background:var(--bad-soft);color:var(--bad)}
.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;display:flex;flex-direction:column;gap:3px;min-width:0}
.kpi .v{font:600 24px var(--f-data);letter-spacing:-.02em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.kpi .n{font-size:12px;color:var(--muted)}
.bar{height:6px;border-radius:99px;background:var(--line);overflow:hidden;margin-top:6px}
.bar i{display:block;height:100%;background:var(--accent);border-radius:99px}
.chart-head{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.legend{display:flex;gap:14px;font-size:12px;color:var(--muted);flex-wrap:wrap}
.legend i{display:inline-block;width:14px;height:3px;border-radius:2px;vertical-align:middle;margin-right:5px}
.k-actual{background:var(--ink)} .k-fore{background:var(--accent)} .k-none{background:var(--bad)} .k-cush{background:var(--warn)}
#chart svg{display:block;width:100%;height:auto}
#chart{position:relative}
#chart .hit{fill:transparent;cursor:crosshair}
#chart .cursor{stroke:var(--muted);stroke-width:1}
#chart .hdot{stroke:var(--panel);stroke-width:2;pointer-events:none}
#chart .h-fore{fill:var(--accent)} #chart .h-none{fill:var(--bad)} #chart .h-actual{fill:var(--ink)}
#chart .hover{pointer-events:none}
.tip{position:absolute;pointer-events:none;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 10px;font-size:12px;box-shadow:0 4px 14px rgba(0,0,0,.18);min-width:180px;display:flex;flex-direction:column;gap:3px;z-index:2}
.tip b{font-size:13px;margin-bottom:2px}
.tip div{display:flex;align-items:center;gap:6px}
.tip div span{margin-left:auto;font-family:var(--f-data)}
.tip i{display:inline-block;width:10px;height:3px;border-radius:2px}
.tip .tev{color:var(--muted)}
/* accounts */
.acct-rows{display:flex;flex-direction:column;gap:6px}
.acct-row{display:grid;grid-template-columns:minmax(0,1fr) 150px;align-items:center;gap:8px;font-weight:500}
.checkin .row .note{align-self:center}
.accts td:first-child{min-width:160px}
.accts thead:not(:first-child) th{padding-top:18px}
.ci-save{justify-content:flex-end}
.add-acct{border-top:1px solid var(--line);padding-top:14px;margin-top:18px}
#pchart svg{display:block;width:100%;height:auto}
#pchart text{font:11px var(--f-data);fill:var(--muted)}
#pchart .grid{stroke:var(--line)} #pchart .fore{fill:none;stroke:var(--accent);stroke-width:2.25} #pchart .dot{fill:var(--accent);stroke:var(--panel);stroke-width:2}
/* forecast vs actual */
.track svg{display:block;width:100%;height:auto;margin:10px 0}
.track text{font:11px var(--f-data);fill:var(--muted)}
.track .zero{stroke:var(--muted)} .track .up{fill:var(--good)} .track .down{fill:var(--bad)}
/* calendar */
.cal-tabs{display:flex;flex-wrap:wrap;gap:4px;margin:6px 0 10px}
.cal-tabs button{font:500 12px var(--f-body);border:1px solid var(--line);background:var(--panel);color:var(--muted);border-radius:7px;padding:4px 9px;cursor:pointer}
.cal-tabs button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:#fff}
.cal-scroll{overflow-x:auto}
.cal{display:grid;grid-template-columns:repeat(7,minmax(96px,1fr));gap:4px}
.cal .dow{font-size:12px;color:var(--muted);text-align:center;padding:2px}
.day{min-height:96px;border:1px solid var(--line);border-radius:8px;padding:4px 6px;overflow:hidden;font-size:12px;display:flex;flex-direction:column;gap:2px}
.day.empty{border-color:transparent}
.day.past{opacity:.5}
.day .dn{font-weight:600;color:var(--muted)}
.day.is-today{outline:2px solid var(--accent);opacity:1}
.cchip{border-radius:5px;padding:1px 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.35;background:var(--accent-soft);color:var(--accent)}
.cchip.income{background:var(--good-soft);color:var(--good);font-weight:600}
.cchip.save{background:var(--warn-soft);color:var(--warn)}
.day .cbal{margin-top:auto;font:600 12px var(--f-data);text-align:right}
.day.low{background:var(--warn-soft)}
.day.neg{background:var(--bad-soft)} .day.neg .cbal{color:var(--bad)}
#chart text{font:11px var(--f-data);fill:var(--muted)}
#chart .grid{stroke:var(--line);stroke-width:1}
#chart .zero{stroke:var(--muted);stroke-width:1}
#chart .cush{stroke:var(--warn);stroke-width:1.5;stroke-dasharray:5 4}
#chart .fore-fill{fill:var(--accent);opacity:.1}
#chart .fore{fill:none;stroke:var(--accent);stroke-width:2.25;stroke-linejoin:round}
#chart .none{fill:none;stroke:var(--bad);stroke-width:2.25;stroke-dasharray:6 4}
#chart .actual{fill:none;stroke:var(--ink);stroke-width:2.5;stroke-linejoin:round}
#chart .dot{fill:var(--ink);stroke:var(--panel);stroke-width:2}
#chart .today{stroke:var(--muted);stroke-dasharray:2 3}
#chart .today-t{fill:var(--ink)}
.two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px}
.list{list-style:none;margin:12px 0 0;padding:0;display:flex;flex-direction:column}
.list li{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;padding:10px 0;border-top:1px solid var(--line);align-items:center}
.list li:first-child{border-top:0}
.list .t{font-weight:500}
.s{font-size:12px;color:var(--muted)}
.amt{font:500 14px var(--f-data);font-variant-numeric:tabular-nums;text-align:right;white-space:nowrap}
.chip{font:500 11px var(--f-body);padding:2px 8px;border-radius:99px;background:var(--accent-soft);color:var(--accent);white-space:nowrap}
.chip.good{background:var(--good-soft);color:var(--good)}
.tips{margin:12px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:8px;color:var(--muted);font-size:14px}
.tips b{color:var(--ink)}
.steps{list-style:none;margin:14px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
.steps a{display:flex;gap:10px;padding:12px;border:1px solid var(--line);border-radius:10px;text-decoration:none;color:var(--ink);height:100%}
.steps a:hover{border-color:var(--accent)}
.steps b{display:block}
.steps .muted{font-size:13px}
.mark{flex:none;width:22px;height:22px;border-radius:99px;border:2px solid var(--line);display:grid;place-items:center;font-size:12px;font-weight:700}
.steps .done .mark{background:var(--good);border-color:var(--good);color:#fff}
.steps .done b{text-decoration:line-through;color:var(--muted)}
.notice{display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between;border-color:var(--accent);background:var(--accent-soft)}
.notice p{margin:4px 0 0}
input,select{font:15px var(--f-body);padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);min-width:0}
input:focus-visible,select:focus-visible,.btn:focus-visible,.mode button:focus-visible,.pick:focus-visible,.linkbtn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600}
.btn{font:600 13px var(--f-body);border:1px solid var(--accent);border-radius:8px;padding:9px 14px;background:var(--accent);color:#fff;cursor:pointer;white-space:nowrap;display:inline-flex;align-items:center;justify-content:center}
.btn.ghost{background:transparent;color:var(--accent)}
.btn.danger{background:transparent;color:var(--bad);border-color:var(--bad)}
.filebtn{flex-direction:row}
.linkbtn{font:inherit;background:none;border:0;padding:0;color:var(--accent);text-decoration:underline;cursor:pointer}
.form-row{display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-top:14px}
.callout{margin-top:14px;padding:12px 14px;border-radius:10px;background:var(--bg)}
.bar-actions{display:flex;gap:10px}
.tbl{width:100%;border-collapse:collapse;font-size:14px}
.tbl th{text-align:left;font:500 11px var(--f-body);text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:8px 8px;border-bottom:1px solid var(--line)}
.tbl td{padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:middle}
.tbl tfoot td{border-bottom:0}
.tbl .num{text-align:right;font-family:var(--f-data);font-variant-numeric:tabular-nums}
.tbl .chk{width:36px}
.tbl tr.off td:not(.chk){opacity:.45}
.nowrap{white-space:nowrap}
.editor form{display:flex;flex-direction:column;gap:16px;margin-top:10px}
.field{display:flex;flex-direction:column;gap:8px}
.lbl{font-size:13px;font-weight:600}
.picker{display:flex;flex-direction:column;gap:8px}
.picks{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.pick{font:500 13px var(--f-body);padding:6px 11px;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--ink);cursor:pointer}
.pick:hover:not(:disabled){border-color:var(--accent)}
.pick.on{background:var(--accent);border-color:var(--accent);color:#fff}
.pick:disabled{opacity:.4;cursor:default}
details summary{cursor:pointer;color:var(--accent);font-size:13px;font-weight:600;margin-top:10px}
.own{max-width:360px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.inline{max-width:240px;margin-top:10px}
.actions,.btns{display:flex;flex-wrap:wrap;gap:10px}
.btns{margin-top:14px}
.cats{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px 18px;margin-top:14px}
.cat{display:grid;grid-template-columns:minmax(0,1fr) 110px auto;gap:10px;align-items:center}
.cat label{font-weight:500;font-size:14px}
.cat input{font-family:var(--f-data);text-align:right}
.total{margin-top:16px;font-size:15px}
/* setup checklist */
.setup{border-color:var(--accent)}
.setup-head{display:flex;gap:12px;justify-content:space-between;align-items:flex-start}
.setup .bar{margin-top:12px}
.steps .next a{border-color:var(--accent);background:var(--accent-soft)}
/* donut charts */
.donut{display:grid;grid-template-columns:170px minmax(0,1fr);gap:20px;align-items:center;margin-top:10px}
.donut svg{width:100%;height:auto}
.d-big{font:600 20px var(--f-data);fill:var(--ink)}
.d-sub{font:11px var(--f-body);fill:var(--muted)}
.d-legend{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;font-size:14px}
.d-legend li{display:grid;grid-template-columns:12px minmax(0,1fr) auto 40px;gap:8px;align-items:center}
.d-legend i{width:12px;height:12px;border-radius:3px}
.d-legend b{font:500 13px var(--f-data);text-align:right}
.d-legend .s{text-align:right}
/* editable tables */
.tbl-wrap{overflow-x:auto}
.tbl.edit td{padding:5px 6px}
.tbl.edit input:not([type=checkbox]),.tbl.edit select{width:100%;padding:7px 8px;font-size:14px;border-color:transparent;background:transparent}
.tbl.edit tr:hover input:not([type=checkbox]),.tbl.edit tr:hover select,.tbl.edit input:focus,.tbl.edit select:focus{border-color:var(--line);background:var(--bg)}
.tbl.edit tr.new td{border-bottom:0;padding-top:10px}
.tbl.edit tr.new input,.tbl.edit tr.new select{border-color:var(--line);background:var(--bg)}
.tbl.edit td:nth-child(2){min-width:180px}
.tbl.edit input[type=date]{min-width:140px}
.money{font-family:var(--f-data)!important;text-align:right}
.tbl.edit td.num .money{max-width:120px;margin-left:auto;display:block}
.opt{font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted);font-size:11px}
.x{border:0;background:none;color:var(--muted);font-size:20px;line-height:1;padding:4px 8px;border-radius:6px;cursor:pointer}
.x:hover{background:var(--bad-soft);color:var(--bad)}
.small-btn{padding:7px 12px}
.quick{margin-top:18px;padding-top:14px;border-top:1px solid var(--line)}
.cats-tbl{margin-top:12px}
.cats-tbl td:first-child{width:60%}
.budget-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:18px;align-items:start}
/* goals */
.kpis.three{grid-template-columns:repeat(3,minmax(0,1fr));margin-top:14px}
.goals{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px}
.goal{display:flex;flex-direction:column;gap:12px}
.goal-head{display:flex;gap:8px;align-items:center}
.goal-name{flex:1;font:600 16px var(--f-display);border-color:transparent;background:transparent;padding:4px 6px}
.goal-name:hover,.goal-name:focus{border-color:var(--line);background:var(--bg)}
.seg{display:inline-flex;background:var(--bg);border:1px solid var(--line);border-radius:9px;padding:3px;align-self:flex-start}
.seg button{font:600 12px var(--f-body);border:0;background:transparent;color:var(--muted);padding:6px 10px;border-radius:6px;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--panel);color:var(--ink);box-shadow:0 1px 2px rgba(0,0,0,.12)}
.goal-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 14px}
.goal-fields input,.goal-fields select{width:100%}
.goal p.s{margin:0}
.goal-mini{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px 24px;margin-top:10px}
.amt-l{font:500 16px var(--f-data)}
@media (max-width:980px){ .kpis{grid-template-columns:repeat(2,minmax(0,1fr))} .two,.budget-grid{grid-template-columns:minmax(0,1fr)} .hero{grid-template-columns:minmax(0,1fr)} .hero-side{border-left:0;padding-left:0;border-top:1px solid var(--line);padding-top:16px} .checkin{border-left:0;padding-left:0;border-top:1px solid var(--line);padding-top:16px} }
@media (max-width:720px){
  .app{grid-template-columns:minmax(0,1fr)}
  nav.side{flex-direction:row;flex-wrap:wrap;padding:12px max(16px, env(safe-area-inset-left,0px));gap:2px;position:static;height:auto}
  .side .brand{padding:6px 10px;width:100%}

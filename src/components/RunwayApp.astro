  main{padding-left:max(16px, env(safe-area-inset-left,0px));padding-right:max(16px, env(safe-area-inset-right,0px))}
  .goals{grid-template-columns:minmax(0,1fr)}
  .donut{grid-template-columns:minmax(0,1fr)} .donut svg{max-width:200px;margin:0 auto}
  .kpis.three{grid-template-columns:minmax(0,1fr)}

---
// Job pipeline: a board and table for tracking applications through each stage.
// Everything saves through /api/jobs to the signed-in account; no job data lives in the repo.
---
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600&family=Schibsted+Grotesk:wght@600;700&display=swap" rel="stylesheet">
<div class="wrap">
  <header class="top">
    <div>
      <h1>Job Pipeline</h1>
      <div class="stats" id="stats" aria-live="polite"></div>
      <div class="stats"><span id="saveStatus" aria-live="polite"></span></div>
    </div>
    <div class="tools">
      <div class="seg" role="group" aria-label="View">
        <button id="v-board" type="button" aria-pressed="true">Board</button>
        <button id="v-table" type="button" aria-pressed="false">Table</button>
      </div>
      <input id="search" class="search" type="search" placeholder="Search company or product" aria-label="Search opportunities">
      <button id="add" class="btn primary" type="button">Add opportunity</button>
      <button id="import-btn" class="btn" type="button">Import data</button>
      <button id="backup-btn" class="btn" type="button">Download backup</button>
      <input id="import" type="file" accept="application/json,.json" hidden>
      <a class="btn" href="/api/auth/signout">Sign out</a>
    </div>
  </header>
  <div id="filters" class="filters" hidden></div>
  <main id="board" class="board" aria-label="Opportunities by stage"></main>
  <div id="table" class="table-wrap" hidden></div>
</div>
<div id="overlay"></div>
<div id="toast" class="toast" role="status" hidden></div>

<style is:global>
[hidden] { display: none !important; }
body { margin: 0; }
a.btn { text-decoration: none; color: inherit; display: inline-block; }
/* Layout: a stage-by-stage board (Applied through Declined) with a slide-over detail panel; columns stack on phones. */
:root {
  --bg: #e9edf1;
  --tray: #dde3e9;
  --surface: #ffffff;
  --ink: #14202b;
  --muted: #566574;
  --line: #c7d1da;
  --accent: #0e6f8f;
  --accent-ink: #ffffff;
  --scrim: rgba(20, 32, 43, 0.45);
  --applied-fg: #4f5e6d;   --applied-bg: #e1e6eb;
  --waiting-fg: #1c5db8;     --waiting-bg: #dbe8fa;
  --scheduling-fg: #86580a; --scheduling-bg: #fbebc8;
  --interview-fg: #0b7869; --interview-bg: #d1efe9;
  --offer-fg: #1d7832;     --offer-bg: #d5f0da;
  --declined-fg: #a13a3a;  --declined-bg: #f5dcdc;
  --font-display: "Schibsted Grotesk", "Helvetica Neue", Arial, sans-serif;
  --font-body: "Instrument Sans", "Helvetica Neue", Arial, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0e151c; --tray: #141d26; --surface: #1b2631; --ink: #e5ecf2; --muted: #92a1b0; --line: #2b3844;
    --accent: #4fb5d5; --accent-ink: #08212b; --scrim: rgba(0, 0, 0, 0.6);
    --applied-fg: #a2b0be;   --applied-bg: #27333f;
    --waiting-fg: #82b3f2;     --waiting-bg: #1b2f4a;
    --scheduling-fg: #e8b552; --scheduling-bg: #3a2f15;
    --interview-fg: #5fd2bf; --interview-bg: #12372f;
    --offer-fg: #70d48b;     --offer-bg: #17391f;
    --declined-fg: #e68d8d;  --declined-bg: #3c2121;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #0e151c; --tray: #141d26; --surface: #1b2631; --ink: #e5ecf2; --muted: #92a1b0; --line: #2b3844;
  --accent: #4fb5d5; --accent-ink: #08212b; --scrim: rgba(0, 0, 0, 0.6);
  --applied-fg: #a2b0be;   --applied-bg: #27333f;
  --waiting-fg: #82b3f2;     --waiting-bg: #1b2f4a;
  --scheduling-fg: #e8b552; --scheduling-bg: #3a2f15;
  --interview-fg: #5fd2bf; --interview-bg: #12372f;
  --offer-fg: #70d48b;     --offer-bg: #17391f;
  --declined-fg: #e68d8d;  --declined-bg: #3c2121;
  color-scheme: dark;
}
body { background: var(--bg); color: var(--ink); font-family: var(--font-body); font-size: 14px; line-height: 1.45; padding-inline: 20px; padding-block: 20px 40px; }
* { box-sizing: border-box; }
button, input, textarea, select { font: inherit; color: inherit; }
a { color: var(--accent); }
:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
[data-stage="applied"] { --sf: var(--applied-fg); --sb: var(--applied-bg); }
[data-stage="waiting"] { --sf: var(--waiting-fg); --sb: var(--waiting-bg); }
[data-stage="scheduling"] { --sf: var(--scheduling-fg); --sb: var(--scheduling-bg); }
[data-stage="interview"] { --sf: var(--interview-fg); --sb: var(--interview-bg); }
[data-stage="offer"] { --sf: var(--offer-fg); --sb: var(--offer-bg); }
[data-stage="declined"] { --sf: var(--declined-fg); --sb: var(--declined-bg); }

.wrap { max-width: 1480px; margin-inline: auto; display: flex; flex-direction: column; gap: 18px; }
.top { display: flex; flex-wrap: wrap; gap: 14px 24px; align-items: flex-end; justify-content: space-between; }
.top h1 { font-family: var(--font-display); font-weight: 700; font-size: 28px; letter-spacing: -0.01em; margin: 0; text-wrap: balance; }
.stats { display: flex; flex-wrap: wrap; gap: 6px 20px; color: var(--muted); margin-top: 4px; font-family: var(--font-mono); font-size: 12px; }
.stats b { color: var(--ink); font-weight: 500; }
.tools { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.search { width: 220px; max-width: 100%; padding: 8px 12px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
.btn { border: 1px solid var(--line); background: var(--surface); padding: 8px 14px; border-radius: 6px; cursor: pointer; font-weight: 500; }
.btn:hover { border-color: var(--accent); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.btn.danger { color: var(--declined-fg); }
.btn.small { padding: 5px 10px; font-size: 13px; }

.board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(205px, 1fr); gap: 12px; overflow: auto; max-height: calc(100vh - 150px); padding-bottom: 8px; align-items: start; }
.col { background: var(--tray); border-radius: 8px; padding: 10px; display: flex; flex-direction: column; gap: 10px; min-width: 0; min-height: 140px; }
.col.over { outline: 2px dashed var(--accent); outline-offset: -2px; }
.col-head { display: flex; align-items: center; gap: 8px; padding: 2px 4px; }
.dot { width: 9px; height: 9px; border-radius: 50%; background: var(--sf); flex: none; }
.col-head h2 { font-family: var(--font-display); font-size: 14px; font-weight: 600; margin: 0; flex: 1; }
.count { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
.cards { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
.empty-col { color: var(--muted); font-size: 12px; padding: 8px 4px; }

.card { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 8px; cursor: pointer; min-width: 0; text-align: left; width: 100%; }
.card:hover { border-color: var(--accent); }
.card.dragging { opacity: 0.45; }
.card[data-stage="declined"] { opacity: 0.7; }
.card-top { display: flex; gap: 8px; align-items: baseline; justify-content: space-between; min-width: 0; }
.company { font-family: var(--font-display); font-weight: 600; font-size: 16px; line-height: 1.2; overflow-wrap: anywhere; }
.company a { color: inherit; text-decoration: none; }
.company a:hover { text-decoration: underline; color: var(--accent); }
.sells { color: var(--muted); font-size: 13px; }
.chips { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
.chip { font-family: var(--font-mono); font-size: 11.5px; padding: 2px 7px; border-radius: 4px; background: var(--tray); color: var(--ink); overflow-wrap: anywhere; }
.next { font-size: 12.5px; padding: 5px 8px; border-radius: 4px; background: var(--sb); color: var(--sf); overflow-wrap: anywhere; }
.age { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }

.scrim { position: fixed; inset: 0; background: var(--scrim); z-index: 10; }
.panel { position: fixed; top: 0; right: 0; bottom: 0; width: min(480px, 100%); background: var(--bg); z-index: 11; overflow-y: auto; padding: 22px 20px calc(28px + env(safe-area-inset-bottom, 0px)); padding-top: calc(22px + env(safe-area-inset-top, 0px)); display: flex; flex-direction: column; gap: 18px; border-left: 1px solid var(--line); }
.panel-head { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
.panel-head h2 { font-family: var(--font-display); font-size: 24px; margin: 0; line-height: 1.15; overflow-wrap: anywhere; }
.panel-head .sub { color: var(--muted); margin-top: 4px; }
.row { display: flex; flex-wrap: wrap; gap: 8px; }
.pill { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 5px 12px; cursor: pointer; font-size: 13px; }
.pill[aria-pressed="true"] { background: var(--sb); color: var(--sf); border-color: var(--sf); font-weight: 600; }
.sec { display: flex; flex-direction: column; gap: 6px; }
.label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.field, .sec textarea { width: 100%; padding: 8px 10px; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
textarea { resize: vertical; min-height: 84px; }
.facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
.facts p, .sec p { margin: 0; overflow-wrap: anywhere; }
.links { display: flex; flex-wrap: wrap; gap: 14px; }
.timeline { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.timeline li { display: flex; gap: 10px; align-items: baseline; font-size: 13px; }
.timeline time { font-family: var(--font-mono); font-size: 12px; color: var(--muted); min-width: 84px; }
.form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.form .full { grid-column: 1 / -1; }
.form label { display: flex; flex-direction: column; gap: 4px; }
.actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; }
.state { padding: 40px 16px; text-align: center; color: var(--muted); grid-column: 1 / -1; }
.seg { display: inline-flex; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--surface); }
.seg button { border: 0; background: transparent; padding: 8px 14px; cursor: pointer; font-weight: 500; }
.seg button[aria-pressed="true"] { background: var(--accent); color: var(--accent-ink); }
.filters { position: relative; display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between; }
.row.center { align-items: center; }
.fchip { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 3px 5px 3px 5px; cursor: pointer; font-size: 13px; }
.fchip > span:first-child:not(.num) { padding-left: 8px; }
.fchip .num { width: 20px; height: 20px; border-radius: 50%; font-size: 11px; }
.fchip .cnt { font-family: var(--font-mono); font-size: 12px; font-weight: 600; min-width: 22px; height: 20px; padding: 0 7px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: var(--ink); color: var(--bg); }
.fchip .cnt.zero { background: var(--tray); color: var(--muted); font-weight: 400; }
.fchip[aria-pressed="true"] { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); font-weight: 600; }
.fchip[data-stage][aria-pressed="true"] { background: var(--sb); border-color: var(--sf); color: var(--sf); }
.fchip[aria-pressed="true"] .cnt { background: var(--accent-ink); color: var(--accent); }
.fchip[data-stage][aria-pressed="true"] .cnt { background: var(--sf); color: var(--sb); }
.fchip[data-stage][aria-pressed="true"] .num { background: var(--sf); color: var(--sb); }
.field.narrow { width: auto; padding: 5px 8px; }
.colmenu { position: absolute; right: 0; top: 100%; margin-top: 6px; z-index: 5; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 12px; display: flex; flex-direction: column; gap: 6px; width: min(300px, 100%); max-height: 60vh; overflow-y: auto; box-shadow: 0 8px 24px var(--scrim); }
.colmenu p { margin: 0 0 4px; }
.colrow { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
.colrow .check { margin: 0; }
.icon-btn { border: 1px solid var(--line); background: var(--bg); border-radius: 4px; width: 26px; height: 26px; cursor: pointer; line-height: 1; }
.icon-btn:disabled { opacity: 0.35; cursor: default; }
.table-wrap { min-width: 0; }
.scroll { overflow: auto; max-height: calc(100vh - 210px); min-height: 160px; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); }
table.grid { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 13px; }
.grid th, .grid td { padding: 8px 12px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); white-space: nowrap; }
.grid td.wide { white-space: normal; min-width: 240px; max-width: 340px; }
.grid th { position: sticky; top: 0; z-index: 2; background: var(--tray); padding: 0; cursor: grab; font-weight: 600; }
.grid th.over { box-shadow: inset 3px 0 0 var(--accent); }
.grid th.sticky, .grid td.sticky { position: sticky; left: 0; z-index: 1; background: var(--surface); border-right: 1px solid var(--line); }
.grid th.sticky { z-index: 3; background: var(--tray); }
.grid tbody tr { cursor: pointer; }
.grid tbody tr:hover td { background: var(--tray); }
.grid tr.declined td { color: var(--muted); }
.th-btn { all: unset; box-sizing: border-box; display: flex; justify-content: space-between; gap: 8px; align-items: center; padding: 9px 12px; width: 100%; min-width: 96px; cursor: pointer; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
.th-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.th-btn .arrow { font-size: 9px; color: var(--accent); }
.cell-company { display: flex; gap: 8px; align-items: baseline; font-family: var(--font-display); font-weight: 600; font-size: 14px; }
.link-btn { all: unset; cursor: pointer; }
.link-btn:hover { color: var(--accent); text-decoration: underline; }
.link-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.stage-select { border: 0; border-radius: 4px; padding: 3px 6px; background: var(--sb); color: var(--sf); font-weight: 600; font-size: 12.5px; cursor: pointer; }
.cell-select { border: 1px solid transparent; background: transparent; border-radius: 4px; padding: 3px 4px; cursor: pointer; }
.cell-select:hover { border-color: var(--line); }
.mono { font-family: var(--font-mono); font-size: 12px; }
.dim { color: var(--muted); }
.num { font-family: var(--font-mono); font-size: 12px; font-weight: 500; width: 22px; height: 22px; border-radius: 4px; display: inline-flex; align-items: center; justify-content: center; background: var(--sb); color: var(--sf); flex: none; }
.chip.pri { background: transparent; border: 1px solid var(--line); }
.chip.pri-high { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
.chip.pri-medium-high { border-color: var(--accent); color: var(--accent); }
.reason { font-size: 12.5px; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; }
.facts .full { grid-column: 1 / -1; }
.check { display: flex; gap: 8px; align-items: center; font-size: 13px; margin-top: 4px; }
.timeline .note { color: var(--muted); }
.timeline li { align-items: flex-start; }
.pill[aria-checked="true"] { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); font-weight: 600; }
.dialog-back { position: fixed; inset: 0; background: var(--scrim); z-index: 30; display: flex; align-items: center; justify-content: center; padding: 16px; }
.dialog { background: var(--bg); border: 1px solid var(--line); border-radius: 10px; padding: 20px; width: min(460px, 100%); max-height: 100%; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }
.dialog h2 { font-family: var(--font-display); font-size: 20px; margin: 0; text-wrap: balance; }
.err { margin: 0; color: var(--declined-fg); font-size: 13px; }
.toast { position: fixed; left: 50%; bottom: calc(18px + env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); background: var(--ink); color: var(--bg); padding: 9px 14px; border-radius: 6px; z-index: 40; max-width: calc(100% - 32px); }

/* Always-visible scrollbars so the board and table can be dragged sideways (macOS hides overlay scrollbars). */
.board::-webkit-scrollbar, .scroll::-webkit-scrollbar { height: 14px; width: 14px; }
.board::-webkit-scrollbar-track, .scroll::-webkit-scrollbar-track { background: var(--tray); border-radius: 7px; }
.board::-webkit-scrollbar-thumb, .scroll::-webkit-scrollbar-thumb { background: var(--muted); border-radius: 7px; border: 3px solid var(--tray); }
.board::-webkit-scrollbar-thumb:hover, .scroll::-webkit-scrollbar-thumb:hover { background: var(--accent); }
.board::-webkit-scrollbar-corner, .scroll::-webkit-scrollbar-corner { background: var(--tray); }
@supports not selector(::-webkit-scrollbar) { .board, .scroll { scrollbar-color: var(--muted) var(--tray); } }
@media (max-width: 760px) {
  body { padding-inline: 16px; }
  .board { grid-auto-flow: row; grid-auto-columns: auto; overflow: visible; max-height: none; }
  .col { min-height: 0; }
  .search { width: 100%; }
  .tools { width: 100%; }
  .facts, .form { grid-template-columns: minmax(0, 1fr); }
}
@media (prefers-reduced-motion: reduce) { * { transition: none !important; animation: none !important; } }
</style>

<script>
  import '../scripts/jobs/app.js';
</script>
